# ==============================================================================
# MouseLife Tracker — Environment Variables Template
# Copy this file to respective .env locations or configure per component:
#   - backend/.env
#   - agent/.env
#   - frontend/.env
# ==============================================================================

# Backend Service Configuration (backend/.env)
PORT=5000
MONGODB_URI=your_mongodb_connection_string
CORS_ORIGIN=*
NODE_ENV=development

# Windows Tracking Agent Configuration (agent/.env)
API_BASE_URL=http://localhost:5000
MOUSE_ID=portronics-default-01
MOUSE_NAME=Portronics Wireless Mouse
MOUSE_MANUFACTURER=Portronics
MOUSE_MODEL=Toad 23 / Wireless Optical
RATED_CLICKS=3000000
SYNC_INTERVAL_SECONDS=5
LOG_LEVEL=INFO
DASHBOARD_URL=http://localhost:5173

# Frontend Dashboard Configuration (frontend/.env)
VITE_API_URL=http://localhost:5000
